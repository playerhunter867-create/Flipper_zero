<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flipper Android"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"/>

    <!-- ВКЛАДКИ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnTabIr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IR"
            android:background="#FF9800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnTabNfc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NFC"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnTabBadUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BADUSB"
            android:background="#2196F3"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- КНОПКИ IR -->
    <LinearLayout
        android:id="@+id/irButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="8dp">

        <!-- ТЕЛЕВИЗОР -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- ТЕЛЕВИЗОР ---"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:padding="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnTvPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Вкл/Выкл"
                android:background="#FF5722"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnTvVolUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Громкость +"
                android:background="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnTvVolDown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Громкость -"
                android:background="#FFC107"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!-- КОНДИЦИОНЕР -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- КОНДИЦИОНЕР ---"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:padding="4dp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnAcPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Вкл/Выкл"
                android:background="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnAcTempUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Температура +"
                android:background="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnAcTempDown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Температура -"
                android:background="#009688"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!-- ТВ-ПРИСТАВКИ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- ТВ-ПРИСТАВКИ ---"
            android:textColor="#9C27B0"
            android:textSize="14sp"
            android:padding="4dp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnBoxPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xiaomi Box Вкл/Выкл"
                android:background="#9C27B0"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!-- ЗАПИСЬ IR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- ЗАПИСЬ С ПУЛЬТА ---"
            android:textColor="#E91E63"
            android:textSize="14sp"
            android:padding="4dp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔴 Записать"
                android:background="#E91E63"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnSendRecorded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Отправить"
                android:background="#FF5722"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ОБЛАСТЬ ВЫВОДА -->
    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1a1a1a"
        android:textColor="#00FF00"
        android:padding="12dp"
        android:textSize="13sp"
        android:typeface="monospace"
        android:text="Выберите вкладку: IR, NFC или BadUSB"/>

</LinearLayout>
