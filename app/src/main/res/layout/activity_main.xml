<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flipper Android"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="8dp"/>

    <!-- ВКЛАДКИ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnTabIr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IR"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnTabNfc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NFC"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnTabBadUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BADUSB"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- КНОПКИ IR (СКРЫТЫ ПО УМОЛЧАНИЮ) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp">

        <LinearLayout
            android:id="@+id/irButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="4dp">

            <!-- ТЕЛЕВИЗОР -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--- ТЕЛЕВИЗОР ---"
                android:textColor="#FF9800"
                android:textSize="12sp"
                android:padding="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnTvPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Вкл/Выкл"
                    android:background="#FF5722"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnTvVolUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Громк +"
                    android:background="#FF9800"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnTvVolDown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Громк -"
                    android:background="#FFC107"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

            </LinearLayout>

            <!-- КОНДИЦИОНЕР -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--- КОНДИЦИОНЕР ---"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:padding="2dp"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnAcPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Вкл/Выкл"
                    android:background="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnAcTempUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Темп +"
                    android:background="#2196F3"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnAcTempDown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Темп -"
                    android:background="#009688"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

            </LinearLayout>

            <!-- ТВ-ПРИСТАВКИ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--- ТВ-ПРИСТАВКИ ---"
                android:textColor="#9C27B0"
                android:textSize="12sp"
                android:padding="2dp"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnBoxPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xiaomi Box"
                    android:background="#9C27B0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

            </LinearLayout>

            <!-- УНИВЕРСАЛЬНЫЙ ПОИСК -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--- УНИВЕРСАЛЬНЫЙ ПОИСК ---"
                android:textColor="#FF5722"
                android:textSize="12sp"
                android:padding="2dp"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnSearchTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 Найти"
                    android:background="#FF5722"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnStopSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏹ СТОП"
                    android:background="#F44336"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

            </LinearLayout>

            <!-- ЗАПИСЬ IR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--- ЗАПИСЬ С ПУЛЬТА ---"
                android:textColor="#E91E63"
                android:textSize="12sp"
                android:padding="2dp"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 Записать"
                    android:background="#E91E63"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnSendRecorded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▶ Отправить"
                    android:background="#FF5722"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_margin="2dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ОБЛАСТЬ ВЫВОДА - УВЕЛИЧЕНА! ЗАНИМАЕТ ВСЁ ОСТАВШЕЕСЯ МЕСТО -->
    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1a1a1a"
        android:textColor="#00FF00"
        android:padding="8dp"
        android:textSize="12sp"
        android:typeface="monospace"
        android:scrollbars="vertical"
        android:text="Выберите вкладку: IR, NFC или BadUSB"/>

</LinearLayout>
