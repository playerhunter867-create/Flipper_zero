<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="8dp">

    <!-- ЗАГОЛОВОК СТИЛЬ FLIPPER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> FLIPPER ZERO // ANDROID"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:typeface="monospace"
        android:padding="8dp"
        android:background="#1A1A1A"/>

    <!-- ВКЛАДКИ (СТИЛЬ ТЕРМИНАЛ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnTabIr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[IR]"
            android:background="#00FF41"
            android:textColor="#0D0D0D"
            android:textSize="14sp"
            android:typeface="monospace"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btnTabNfc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[NFC]"
            android:background="#333333"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:typeface="monospace"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btnTabBadUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[BADUSB]"
            android:background="#333333"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:typeface="monospace"
            android:layout_margin="2dp"/>

    </LinearLayout>

    <!-- КНОПКИ IR (СКРЫТЫ ПО УМОЛЧАНИЮ) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp">

        <LinearLayout
            android:id="@+id/irButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="4dp">

            <!-- ПОИСК КОНДИЦИОНЕРОВ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="> SEARCH: AC UNITS"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:typeface="monospace"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnSearchAc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[SCAN]"
                    android:background="#00FF41"
                    android:textColor="#0D0D0D"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnStopSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[STOP]"
                    android:background="#FF0044"
                    android:textColor="#0D0D0D"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

            </LinearLayout>

            <!-- ПОИСК ТВ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="> SEARCH: TV UNITS"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:typeface="monospace"
                android:padding="4dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnSearchTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[SCAN]"
                    android:background="#00FF41"
                    android:textColor="#0D0D0D"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnStopSearchTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[STOP]"
                    android:background="#FF0044"
                    android:textColor="#0D0D0D"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

            </LinearLayout>

            <!-- КНОПКИ УПРАВЛЕНИЯ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="> CONTROL"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:typeface="monospace"
                android:padding="4dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[PWR]"
                    android:background="#333333"
                    android:textColor="#00FF41"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[VOL+]"
                    android:background="#333333"
                    android:textColor="#00FF41"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[VOL-]"
                    android:background="#333333"
                    android:textColor="#00FF41"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:layout_margin="2dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ОБЛАСТЬ ВЫВОДА (СКРОЛЛ) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:typeface="monospace"
            android:text="> SYSTEM READY\n> SELECT IR TO START"/>
    </ScrollView>

</LinearLayout>
